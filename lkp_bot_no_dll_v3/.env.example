# Never commit .env or send its contents. Existing .env is never overwritten.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
DAILY_QUESTION_LIMIT=25

# Local AI; run Ollama and install this model first.
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200

# Optional: create embeddings.sqlite before enabling. Otherwise FTS is used.
SEMANTIC_SEARCH=false
EMBEDDING_MODEL=bge-m3

# External archive transfer requires explicit opt-in. Leave false for local use.
ALLOW_EXTERNAL_AI=false
AI_API_KEY=
